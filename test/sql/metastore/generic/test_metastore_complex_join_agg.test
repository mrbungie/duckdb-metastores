# name: test/sql/metastore/generic/test_metastore_complex_join_agg.test
# description: Complex join and aggregation over mock metastore tables
# group: [generic]

require metastore

require parquet

require json

statement ok
CREATE TABLE complex_mock_ns(name VARCHAR);

statement ok
INSERT INTO complex_mock_ns VALUES ('main');

statement ok
CREATE TABLE complex_mock_tabs(
  schema_name VARCHAR,
  table_name VARCHAR,
  location VARCHAR,
  format VARCHAR,
  partition_key VARCHAR
);

statement ok
CREATE TABLE complex_mock_parts(
  schema_name VARCHAR,
  table_name VARCHAR,
  part_value VARCHAR,
  location VARCHAR
);

statement ok
CREATE TABLE complex_mock_cols(
  schema_name VARCHAR,
  table_name VARCHAR,
  column_name VARCHAR,
  column_type VARCHAR,
  column_index INTEGER
);

statement ok
ATTACH 'mock:///main' AS complex_mock (
  TYPE metastore,
  extra_options {
    namespaces_table: 'complex_mock_ns',
    tables_table: 'complex_mock_tabs',
    partitions_table: 'complex_mock_parts',
    columns_table: 'complex_mock_cols'
  }
);

statement ok
COPY (
  SELECT * FROM (
    VALUES
      (1, 101, 120.50, 'us-east'),
      (2, 102, 80.00, 'us-west'),
      (3, 101, 210.25, 'us-east'),
      (4, 103, 45.00, 'eu-central'),
      (5, 104, 500.00, 'us-west'),
      (6, 105, 130.75, 'eu-central')
  ) t(order_id, customer_id, amount, region)
) TO 'tmp_complex_mock_orders.parquet' (FORMAT PARQUET, OVERWRITE 1);

statement ok
COPY (
  SELECT * FROM (
    VALUES
      (101, 'enterprise', true),
      (102, 'smb', true),
      (103, 'smb', false),
      (104, 'enterprise', true),
      (105, 'midmarket', true)
  ) t(customer_id, customer_tier, is_active)
) TO 'tmp_complex_mock_customers.csv' (FORMAT CSV, HEADER 1, OVERWRITE 1);

statement ok
COPY (
  SELECT * FROM (
    VALUES
      ('s1', 1, 101, 'purchase', '2026-01-01 10:00:00'),
      ('s2', 2, 102, 'view', '2026-01-02 09:00:00'),
      ('s3', 3, 101, 'purchase', '2026-01-03 12:00:00'),
      ('s4', 5, 104, 'purchase', '2026-01-04 15:00:00'),
      ('s5', 6, 105, 'view', '2026-01-05 20:00:00'),
      ('s6', 6, 105, 'purchase', '2026-01-06 08:00:00')
  ) t(session_id, order_id, customer_id, event_type, event_ts)
) TO 'tmp_complex_mock_events.json' (FORMAT JSON, OVERWRITE 1);

statement ok
INSERT INTO complex_mock_tabs VALUES
