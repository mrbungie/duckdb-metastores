statement ok
INSERT INTO complex_mock_cols VALUES
('main', 'orders_pq', 'order_id', 'integer', 0),
('main', 'orders_pq', 'customer_id', 'integer', 1),
('main', 'orders_pq', 'amount', 'double', 2),
('main', 'orders_pq', 'region', 'string', 3),
('main', 'customers_csv', 'customer_id', 'integer', 0),
('main', 'customers_csv', 'customer_tier', 'string', 1),
('main', 'customers_csv', 'is_active', 'boolean', 2),
('main', 'events_json', 'session_id', 'string', 0),
('main', 'events_json', 'order_id', 'integer', 1),
('main', 'events_json', 'customer_id', 'integer', 2),
('main', 'events_json', 'event_type', 'string', 3),
('main', 'events_json', 'event_ts', 'string', 4);

query IIIIIIII
WITH base AS (
  SELECT
    c.customer_tier,
    o.region,
    date_trunc('month', try_strptime(e.event_ts, '%Y-%m-%d %H:%M:%S')) AS event_month,
    count(*) AS joined_rows,
    sum(o.amount) AS gross_revenue,
    approx_count_distinct(e.session_id) AS distinct_sessions,
    sum(CASE WHEN e.event_type = 'purchase' THEN 1 ELSE 0 END) AS purchase_events
  FROM complex_mock.main.orders_pq o
  JOIN complex_mock.main.customers_csv c ON o.customer_id = c.customer_id
  LEFT JOIN complex_mock.main.events_json e ON e.order_id = o.order_id AND e.customer_id = o.customer_id
  WHERE o.amount > 50 AND c.is_active = true
  GROUP BY 1, 2, 3
), ranked AS (
  SELECT *, dense_rank() OVER (PARTITION BY customer_tier ORDER BY gross_revenue DESC) AS rev_rank
  FROM base
)
SELECT
  customer_tier,
  region,
  event_month,
  joined_rows,
  round(gross_revenue, 2) AS gross_revenue,
  distinct_sessions,
  purchase_events,
  rev_rank
FROM ranked
WHERE gross_revenue > 100
ORDER BY customer_tier, rev_rank, region;
