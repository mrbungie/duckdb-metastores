# name: test/sql/metastore/generic/test_metastore_read.test
# description: Test partition pruning and metastore_read directly
# group: [generic]

require metastore

# Ensure missing catalog fails explicitly
statement error
SELECT * FROM metastore_read('missing_cat', 'db', 'table')
----
Catalog is not attached as metastore, or not found: missing_cat

# Test that empty string fails in metastore_table_info
statement error
SELECT * FROM metastore_table_info('', 'db', 'table')
----

# Test that NULL fails in metastore_table_info
statement error
SELECT * FROM metastore_table_info(NULL, 'db', 'table')
----
